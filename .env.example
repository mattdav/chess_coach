# chess_coach — variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être committé.

# ── API Claude (obligatoire) ───────────────────────────────────────────────
# Génère le plan d'entraînement hebdomadaire personnalisé.
# Clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude à utiliser (optionnel).
# Défaut si absent : claude-sonnet-4-5
# Les snapshots datés (ex. claude-sonnet-4-20250514) sont périodiquement
# dépréciés par Anthropic — préférer un alias stable comme claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5

 ── OpenAI (obligatoire) ──────────────────────────────────────────────────
# Requis par caissAI au démarrage même si comment=False (pas de résumé GPT).
# Requis par podgenai pour la génération TTS des podcasts.
# Clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Modèle texte utilisé en interne par podgenai pour générer les scripts (optionnel).
# podgenai code ce modèle en dur (snapshot daté, ex. gpt-5.2-chat-latest) et
# OpenAI le déprécie périodiquement sans que podgenai ne publie de correctif.
# chess_coach le patche au démarrage — défaut si absent : gpt-5.6
# PODGENAI_TEXT_MODEL=gpt-5.6

# ── Fichier PGN par défaut (optionnel) ───────────────────────────────────
# Base PGN analysée quand --pgn n'est pas passé en argument. Utile quand la
# base est toujours au même endroit (export ChessBase récurrent).
# CHESS_COACH_PGN=C:/Users/moi/ChessBase/Bases/Parties/mes parties.pgn

# ── Emplacements de sortie (optionnels) ───────────────────────────────────
# Où chess_coach écrit ses productions. Chemins absolus recommandés : le
# programme peut être lancé depuis n'importe quel dossier.
# Précédence : argument CLI > variable ci-dessous > défaut.
# Défaut si absent : %LOCALAPPDATA%\chess_coach\ (Windows), sinon
# ~/.local/share/chess_coach/ — jamais dans le package installé, qui serait
# écrasé à chaque mise à jour.

# Base SQLite (snapshots hebdomadaires, tendance ACPL)
# CHESS_COACH_DATA_DIR=C:/Users/moi/Documents/chess_coach

# Plans d'entraînement Markdown générés
# CHESS_COACH_PLANS_DIR=C:/Users/moi/Documents/chess_coach/plans

# Podcasts MP3 générés par podgenai
# CHESS_COACH_PODCAST_DIR=C:/Users/moi/Podcasts

# Journal applicatif (défaut : dossier log/ du package)
# CHESS_COACH_LOG_DIR=C:/Users/moi/Documents/chess_coach/log

# Fichier player_config.yaml (nom, elo, critères de filtrage).
# Défaut : <CHESS_COACH_DATA_DIR>/player_config.yaml. Au premier lancement,
# le modèle livré avec le package y est copié ; il n'est ensuite jamais
# écrasé. À ne renseigner que pour pointer un emplacement hors du dossier
# d'état (chemin complet du fichier, pas du dossier).
# CHESS_COACH_CONFIG=C:/Users/moi/Documents/chess_coach/player_config.yaml

# ── Lichess (optionnel mais recommandé) ───────────────────────────────────
# Token OAuth personnel pour récupérer les parties de grands maîtres.
# Sans ce token, l'étape "parties GM" est ignorée et le plan n'inclut
# pas d'exemples de parties à étudier.
# Générer un token (lecture seule, aucun scope requis) sur :
# https://lichess.org/account/oauth/token
LICHESS_TOKEN=lip_...
